{"type":"TEXT","ticket":815,"id":"e33374"}||{"groupId":"","locked":false,"zIndex":590,"x":50,"y":1020,"rotation":0,"value":"1-器件放置\n   A：顶部菜单-放置-器件（快捷键：Shift+F）\n   B：底部元件库-器件（快捷键：S）\n   C：左侧基础库-个人库或系统库\n2-连接导线\n   A：顶部菜单-放置-导线，将器件的引脚相互连接起来\n   B：顶部图像导航选择导线图标：     （快捷键W）","color":null,"fillColor":null,"fontFamily":null,"fontSize":30,"strikeout":null,"underline":null,"italic":null,"fontWeight":null,"align":"LEFT_BOTTOM","version":"2.0","yAxisDirection":"up"}|
{"type":"ELE_PLACEHOLDER","ticket":816,"id":"placeholder126"}||{"dataType":"TEXT","max":834}|
